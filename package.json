{
  "name": "instagram-mcp",
  "version": "1.0.0-rc.1",
  "description": "Self-hosted MCP server for Instagram using only Meta's official Instagram Platform API",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": { "instagram-mcp": "dist/cli.js" },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=22.13" },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "start": "node dist/cli.js serve"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  }
}
