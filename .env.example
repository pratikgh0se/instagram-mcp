# instagram-mcp v1 environment variables. Never commit real values.
# Normally secrets live in the keychain / encrypted file; env vars are for CI, Docker and tests.

# State directory (default ~/.instagram-mcp) and config file override.
# INSTAGRAM_MCP_HOME=~/.instagram-mcp
# INSTAGRAM_MCP_CONFIG=

# Secrets (env backend, or overrides for any backend).
# Access token per account: alias uppercased, non-alphanumerics become "_".
# INSTAGRAM_MCP_TOKEN_MAIN=replace-me
# INSTAGRAM_MCP_APP_SECRET=replace-me
# INSTAGRAM_MCP_HTTP_TOKEN=replace-me
# INSTAGRAM_MCP_WEBHOOK_VERIFY_TOKEN=replace-me

# encrypted-file backend: base64 of 32 random bytes (openssl rand -base64 32), or a passphrase.
# INSTAGRAM_MCP_MASTER_KEY=
# INSTAGRAM_MCP_PASSPHRASE=

# Test hooks: point Graph calls at a fake server (replaces scheme+host; the version segment is still appended).
# INSTAGRAM_MCP_GRAPH_URL_INSTAGRAM=http://127.0.0.1:9999
# INSTAGRAM_MCP_GRAPH_URL_FACEBOOK=http://127.0.0.1:9999
# INSTAGRAM_MCP_RUPLOAD_URL=http://127.0.0.1:9999
# INSTAGRAM_MCP_POLL_INTERVAL_MS=2000
# INSTAGRAM_MCP_TEST_MODE=1
# INSTAGRAM_MCP_NOW=2026-10-29T12:00:00Z

# Logging to stderr: debug | info | warn | error (default warn).
# INSTAGRAM_MCP_LOG=warn
